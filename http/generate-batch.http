> {%
    client.test("Batch PDF generated", function() {
        client.assert(response.status === 201);
        client.assert(response.body.id !== undefined);
        client.assert(response.body.count === 500);
        client.log("Lot généré : " + response.body.fileName +
            " (" + response.body.count + " documents, " +
            Math.round(response.body.sizeBytes / 1024) + " Ko, " +
            response.body.totalMs + " ms)");
    });
%}

###

### Petit lot — 5 exemplaires (utile pour valider sans attendre)
POST http://localhost:8080/api/documents/generate-batch
Content-Type: application/json

{
  "templateName": "attestation-assurance.docx",
  "count": 5,
  "data": {
    "customerName": "Jean Dupont",
    "policyNumber": "POL-2026-000123",
    "startDate": "2026-04-01",
    "endDate": "2027-03-31",
    "premium": "1250,50 €",
    "address": "10 rue Exemple, 75001 Paris"
  },
  "tables": {
    "movements": [
      ["01/04/2026", "Prélèvement prime mensuelle", "-125,05 €", "8 432,50 €"]
    ]
  }
}

> {%
    client.test("Small batch generated", function() {
        client.assert(response.status === 201);
        client.assert(response.body.count === 5);
    });
%}

###

### Téléchargement du PDF fusionné (utiliser l'id renvoyé par /generate-batch)
GET http://localhost:8080/api/documents/{{batchId}}/download
Accept: application/pdf
