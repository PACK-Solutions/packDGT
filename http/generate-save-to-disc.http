### Génération avec sauvegarde sur disque
POST http://localhost:8080/generate
Content-Type: application/json

{
  "templateName": "attestation-assurance.docx",
  "outputFileName": "attestation-sauvegardee.pdf",
  "data": {
    "customerName": "Pierre Durand",
    "policyNumber": "POL-2026-000789",
    "startDate": "2026-01-01",
    "endDate": "2026-12-31",
    "premium": "2 100,00 €",
    "address": "3 place Bellecour, 69002 Lyon"
  },
  "tables": {
    "movements": [
      ["01/01/2026", "Souscription contrat", "-2 100,00 €", "7 900,00 €"],
      ["01/01/2026", "Virement initial", "+10 000,00 €", "10 000,00 €"]
    ]
  },
  "options": {
    "author": "Insurance API",
    "title": "Attestation — Pierre Durand",
    "saveToDisc": true
  }
}

> {%
    client.test("PDF generated and saved to disc", function() {
        client.assert(response.status === 200);
        client.assert(response.contentType.mimeType === "application/pdf");
    });
%}
