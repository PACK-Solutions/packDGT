    client.test("Relevé de compte PDF generated", function() {
        client.assert(response.status === 200);
        client.assert(response.contentType.mimeType === "application/pdf");
        var disposition = response.headers.valueOf("Content-Disposition");
        client.assert(disposition.indexOf("releve-compte-anglaret-2025.pdf") !== -1);
    });
%}

